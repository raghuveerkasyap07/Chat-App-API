<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivFullscreenPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="Fullscreen Image Preview"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnClosePreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Preview"
        android:src="@drawable/ic_logout"
        app:tint="@color/white" xmlns:app="http://schemas.android.com/apk/res-auto" />

</FrameLayout>
